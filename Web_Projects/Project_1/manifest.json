{
  "manifest_version": 3,
  "name": "Smart Dost",
  "version": "1.0.0",
  "description": "A private, practical productivity toolkit for Chrome.",
  "action": {
    "default_title": "Smart Dost",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
